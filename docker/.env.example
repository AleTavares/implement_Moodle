# cp docker/.env.example docker/.env

# =============================================================================
# Configuração do banco de dados (PostgreSQL)
# =============================================================================

# Nome do banco de dados criado no PostgreSQL
POSTGRES_DB=moodle

# Usuário do banco de dados PostgreSQL
POSTGRES_USER=moodle

# Senha do banco de dados PostgreSQL — substitua por uma senha forte
POSTGRES_PASSWORD=changeme_strong_password

# =============================================================================
# Configuração Moodle
# =============================================================================

# Endereço do serviço de banco de dados (nome do serviço no docker-compose)
MOODLE_DATABASE_HOST=db

# Porta do banco de dados PostgreSQL
MOODLE_DATABASE_PORT_NUMBER=5432

# Nome do banco de dados que o Moodle irá utilizar
MOODLE_DATABASE_NAME=moodle

# Usuário do banco de dados utilizado pelo Moodle
MOODLE_DATABASE_USER=moodle

# Senha do banco de dados utilizada pelo Moodle — deve coincidir com POSTGRES_PASSWORD
MOODLE_DATABASE_PASSWORD=changeme_strong_password

# Nome de usuário do administrador do Moodle
MOODLE_USERNAME=admin

# Senha do administrador do Moodle — substitua por uma senha forte
MOODLE_PASSWORD=Admin1234!

# Nome exibido no site Moodle
MOODLE_SITE_NAME=Moodle Challenge
